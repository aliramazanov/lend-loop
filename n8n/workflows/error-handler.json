{
  "id": "lendloopErrHndlr",
  "name": "LendLoop - Error Handler",
  "nodes": [
    {
      "parameters": {},
      "id": "error-trigger",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "field-executionId",
              "name": "executionId",
              "value": "={{ String($json.execution?.id ?? (($json.workflow?.name ?? 'workflow') + ':' + $now.toMillis())) }}",
              "type": "string"
            },
            {
              "id": "field-summary",
              "name": "summary",
              "value": "={{ ($json.workflow?.name ?? 'unknown') + ' [' + ($json.execution?.lastNodeExecuted ?? 'unknown') + ']: ' + ($json.execution?.error?.message ?? 'Unknown error') }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "error-report",
      "name": "Build Error Report",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "lendloopSignCall"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "method": "POST",
            "path": "/api/n8n/automation-error",
            "body": "={{ JSON.stringify({ executionId: $json.executionId, summary: $json.summary }) }}"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "method",
              "displayName": "method",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "string",
              "removed": false
            },
            {
              "id": "path",
              "displayName": "path",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "string",
              "removed": false
            },
            {
              "id": "body",
              "displayName": "body",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "string",
              "removed": false
            }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        },
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "error-send",
      "name": "Report Error to Convex",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        660,
        300
      ]
    }
  ],
  "connections": {
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Build Error Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Error Report": {
      "main": [
        [
          {
            "node": "Report Error to Convex",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
