{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y", "nextjs", "import", "vitest"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": ["convex/_generated/**", ".next/**"],
  "rules": {
    "nextjs/no-img-element": "off",
    "typescript/no-deprecated": "error",
    "curly": ["error", "multi-line"],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "./_generated/server",
            "importNames": ["query", "mutation", "action"],
            "message": "Build Convex functions with the access-level builders in convex/lib/functions."
          },
          {
            "name": "../_generated/server",
            "importNames": ["query", "mutation", "action"],
            "message": "Build Convex functions with the access-level builders in convex/lib/functions."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["convex/lib/functions.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
